{
  "manifest_version": 3,
  "name": "media-launcher",
  "description": "Sends videos in pages like YouTube to an external media player",
  "icons": { "128": "play-logo.png" },
  "version": "0.1.0",

  "commands": {
    "play-current-page": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Play the current page with Media Launcher"
    },
    "queue-current-page": {
      "suggested_key": { "default": "Alt+Shift+Q" },
      "description": "Queue the current page with Media Launcher"
    }
  },

  "permissions": ["storage", "activeTab", "contextMenus", "scripting", "notifications", "alarms", "sidePanel"],
  "host_permissions": [
    "http://localhost:*/*",
    "http://127.0.0.1:*/*",
    "https://img.youtube.com/*",
    "https://*.youtube.com/*",
    "https://i.vimeocdn.com/*",
    "https://*.dailymotion.com/*",
    "https://images.dmcdn.net/*",
    "https://static-cdn.jtvnw.net/*",
    "https://i0.hdslb.com/*",
    "https://i1.sndcdn.com/*",
    "https://pbs.twimg.com/*",
    "https://i.redd.it/*",
    "https://preview.redd.it/*",
    "https://raven.rumble.com/*",
    "https://thumbnail.odycdn.com/*"
  ],

  "side_panel": {
    "default_path": "sidebar.html"
  },

  "action": {
    "default_title": "Play with Media Launcher",
    "default_icon": "play-logo.png",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/background.ts"
  },
  "content_scripts": [
    {
      "js": ["src/content/content.ts"],
      "matches": ["<all_urls>"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["play-logo.png"],
      "matches": ["<all_urls>"]
    }
  ]
}