{
  "manifest_version": 3,
  "name": "Media Launcher",
  "version": "1.1.0",
  "description": "Send videos from YouTube, Vimeo, Twitch and more to mpv on your computer.",
  "homepage_url": "https://github.com/riad-boussaid/media-launcher",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },

  "commands": {
    "play-current-page": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Play the current page with Media Launcher"
    },
    "queue-current-page": {
      "suggested_key": { "default": "Alt+Shift+Q" },
      "description": "Queue the current page with Media Launcher"
    },
    "save-current-page": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Save the current page to Watch Later"
    }
  },

  "sidebar_action": {
    "default_panel": "sidebar.html",
    "default_title": "Media Launcher",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    }
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "media-launcher@riad-boussaid",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "permissions": ["storage", "activeTab", "contextMenus", "notifications", "alarms"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://img.youtube.com/*",
    "https://*.youtube.com/*",
    "https://i.vimeocdn.com/*",
    "https://*.dailymotion.com/*",
    "https://images.dmcdn.net/*",
    "https://static-cdn.jtvnw.net/*",
    "https://i0.hdslb.com/*",
    "https://i1.sndcdn.com/*",
    "https://pbs.twimg.com/*",
    "https://i.redd.it/*",
    "https://preview.redd.it/*",
    "https://raven.rumble.com/*",
    "https://thumbnail.odycdn.com/*"
  ],

  "action": {
    "default_title": "Play with Media Launcher",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup.html"
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "background": {
    "scripts": ["background.js"]
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["play-logo.png"],
      "matches": ["<all_urls>"]
    }
  ]
}