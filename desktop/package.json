{
  "name": "media-launcher-desktop",
  "version": "1.0.0",
  "description": "Modern desktop tray app for media-launcher",
  "license": "MIT",
  "homepage": "https://github.com/riad-boussaid/media-launcher",
  "desktopName": "media-launcher.desktop",
  "author": {
    "name": "Riad Boussaid",
    "email": "riadsoso@gmail.com"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:server": "pnpm -C ../server run build && node scripts/prepare-server.js",
    "type-check": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "preview": "electron-vite preview",
    "dist": "pnpm run build:server && pnpm run build && electron-builder --publish never",
    "dist:win": "pnpm run build:server && pnpm run build && electron-builder --win --x64 --publish never",
    "dist:mac": "pnpm run build:server && pnpm run build && electron-builder --mac --x64 --arm64 --publish never",
    "dist:linux": "pnpm run build:server && pnpm run build && electron-builder --linux --x64 --publish never",
    "dist:dir": "pnpm run build:server && pnpm run build && electron-builder --dir --publish never",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/"
  },
  "build": {
    "appId": "com.media-launcher.desktop",
    "productName": "Media Launcher",
    "copyright": "Copyright © 2026 Riad Boussaid",
    "artifactName": "Media-Launcher-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "afterPack": "scripts/copy-server.js",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Media Launcher"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.video",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": true
    },
    "dmg": {
      "title": "${productName} ${version}",
      "iconSize": 96
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons",
      "category": "AudioVideo",
      "synopsis": "Send videos from your browser to mpv",
      "description": "Media Launcher sends videos from your browser to mpv, with queueing, playback history, resume, and remote control from a phone.",
      "maintainer": "Riad Boussaid <riadsoso@gmail.com>",
      "vendor": "Riad Boussaid",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "Media Launcher",
          "Comment": "Send videos from your browser to mpv",
          "Categories": "AudioVideo;Player;",
          "Keywords": "video;player;mpv;youtube;streaming;"
        }
      }
    },
    "deb": {
      "recommends": [
        "mpv",
        "yt-dlp"
      ]
    }
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "electron-squirrel-startup": "^1.0.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "postcss": "^8.5.33",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
