{
  "name": "media-launcher-server",
  "version": "2.0.0",
  "description": "Standalone API server for media-launcher",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "start": "node dist/index.js",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/"
  },
  "author": "riad boussaid",
  "license": "ISC",
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "better-sqlite3": "^13.0.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3"
  }
}
