{
  "name": "media-launcher-server",
  "version": "1.0.0",
  "description": "Standalone API server for media-launcher",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "watch": "tsx watch src/index.ts",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "start": "node dist/index.js",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/"
  },
  "author": "riad boussaid",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
