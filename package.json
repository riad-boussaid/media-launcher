{
  "name": "media-launcher",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "build": "pnpm run build:desktop && pnpm run build:chrome && pnpm run build:firefox",
    "build:desktop": "pnpm -C desktop run build",
    "build:chrome": "pnpm -C extensions/chrome run build",
    "build:firefox": "pnpm -C extensions/firefox run build",
    "dev:desktop": "pnpm -C desktop run dev",
    "dev:chrome": "pnpm -C extensions/chrome run dev",
    "dev:firefox": "pnpm -C extensions/firefox run dev",
    "lint": "biome check server/src/ desktop/src/",
    "lint:fix": "biome check --write server/src/ desktop/src/",
    "format": "biome format --write server/src/ desktop/src/",
    "type-check": "pnpm -C server run type-check && pnpm -C desktop run type-check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5"
  }
}
